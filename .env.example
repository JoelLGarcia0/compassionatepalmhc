# Resend API key. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=

# Sender identity. The domain must be verified in Resend.
# Falls back to the shared proxy domain if unset.
CONTACT_FROM_EMAIL=Compassionate Palm Health Care <contact@restweb.dev>

# Canonical site URL, used for metadata, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://compassionatepalmhealthcare.com
